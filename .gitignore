# Lock files
# ============================================================
uv.lock

# ============================================================
# KEEP THESE FILES
# ============================================================
!.gitmodules
!.python-version
!.gitignore
!README.md
!Context.md
!pyproject.toml
!run_sae.slurm

# ============================================================
# KEEP SOURCE TREE
# ============================================================
!src/
!src/**

# ============================================================
# KEEP MAIN SCRIPTS
# ============================================================
!main.py
!saev5.py
!sae_shared.py
!download_sae.py
!baseline_gemmascope.py
!test_chargement_sae.py

# ============================================================
# CRITICAL OVERRIDES (Must be at the very bottom)
# ============================================================
# Force l'exclusion du cache Python partout, même dans src/
**/__pycache__/
*.pyc
*.py[cod]
*.so

# Force l'exclusion des logs et SLURM partout
*.log
*.out
*.err
slurm-*.out
slurm-*.err

# Force l'exclusion de tous les dossiers de résultats
results/
results_*/