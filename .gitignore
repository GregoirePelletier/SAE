# ============================================================
# Virtual environments & IDE
# ============================================================
.venv/
venv/
ENV/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================================
# Environment & Build artifacts
# ============================================================
.env
.env.*
!.env.example
build/
dist/
wheels/
*.egg-info/

# ============================================================
# Large generated / downloaded data
# ============================================================
Mails.tsv
models/
datasets/
saes/
# Artefacts d'expérimentation locale (caches de labels, poids, jeux de test
# synthétiques générés à la volée — régénérables via download_sae.py /
# neuronpedia_labels.fetch_neuronpedia_labels / scripts/retrieval_demo.py)
local_data/

# Documents de référence (papiers, offre de stage) : volumineux, pas du code,
# pas destinés à être versionnés (droits d'auteur / contenu personnel pour
# l'offre de stage). Toujours disponibles en local sous pdf/.
pdf/

# Future-proofing
outputs/
checkpoints/
embeddings/
cache/
archive/

# ============================================================
# Downloaded artifacts (Weights, Tensors)
# ============================================================
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npz
*.npy
*.parquet
*.pickle
*.pkl

# ============================================================
# Lock files
# ============================================================
uv.lock

# ============================================================
# KEEP THESE FILES
# ============================================================
!.gitmodules
!.python-version
!.gitignore
!README.md
!CLAUDE.md
!pyproject.toml

# ============================================================
# KEEP SOURCE TREE
# ============================================================
!src/
!src/**

# ============================================================
# CRITICAL OVERRIDES (Must be at the very bottom)
# ============================================================
# Force l'exclusion du cache Python partout, même dans src/
**/__pycache__/
*.pyc
*.py[cod]
*.so
.pytest_cache/

# Force l'exclusion des logs et SLURM partout (les scripts .slurm eux-mêmes
# restent versionnés sous slurm/ — seule leur SORTIE ne l'est pas, cf. logs/)
*.log
*.out
*.err
slurm-*.out
slurm-*.err

# Force l'exclusion de tous les dossiers de résultats
results/
results_*/