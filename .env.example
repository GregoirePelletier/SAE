# Variables d'environnement pour lancer la pipeline. Copier en .env et charger avant
# de lancer un script, ou exporter directement. Tout est déjà surchargé par défaut vers
# ces valeurs dans src/config.py — ce fichier documente juste les leviers disponibles.

# ─── Profil principal : Gemma-3-12B-it (machine avec assez de VRAM, ~24 Go+ recommandé
# pour un run complet non réduit — voir run_sae.slurm pour les volumes cluster) ───
MODEL_SIZE=12b
# bf16 obligatoire (pas fp16) : Gemma-3 a des activations massives dans le residual
# stream (outliers ~1e5) qui overflow en fp16 (max ~65504) -> Loss=nan dans ExtendedSAE,
# confirmé empiriquement sur la validation locale 270m. Voir src/config.py pour le détail.
DTYPE=bf16
CLUSTER_OFFLINE_MODE=0

# google/gemma-3-12b-it et google/gemma-scope-2-12b-it sont des repos HF "gated" :
# créer un compte HF, accepter la licence Gemma sur la page du modèle, générer un
# token sur https://huggingface.co/settings/tokens.
HF_TOKEN=hf_...

# Windows uniquement : si le nom d'utilisateur contient un caractère accentué ou que
# le chemin HOME est long, le cache HF (~/.cache/huggingface) peut dépasser MAX_PATH
# (260 car.) sur les fichiers de lock -> OSError [Errno 22]. Rediriger vers un chemin
# court sans accent réglera le problème.
# HF_HOME=C:\hfcache

# Mails.tsv (corpus EDF) : chemin réel sur la machine de calcul.
LOCAL_MAILS_PATH=./local_data/Mails.tsv

# ─── Profil de validation rapide (6 Go VRAM, Gemma-3-270m-it) ───
# Utilisé pour valider tout le pipeline de bout en bout sur une machine modeste
# avant de lancer le run complet 12b (labels du juge LLM moins fiables sur
# 270m qu'avec un modèle plus grand).
# MODEL_SIZE=270m
# SAVE_DIR=./results_local/
# LOCAL_SAE_DIR=./local_data/saes/gemma-scope-2-270m-it
# N_TOTAL_ENERGY=60
# N_TOTAL_SPORTS=60
# N_TOTAL_SUPPORT=60
# N_TOKENS_EXTRA_TRAIN=20000
# N_FEATURES_TO_LABEL=10

# Mails.tsv absent de la machine de validation locale : laisser LOCAL_MAILS_PATH pointer
# vers un fichier inexistant pour activer le fallback synthétique de saev5.py, ou utiliser
# scripts/retrieval_demo.py qui génère un substitut public FineWeb-2 pour tester ces
# briques sans données EDF réelles.
